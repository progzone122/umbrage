# Build Umbrage as a Linux AppImage inside a container.
#
# Ubuntu 22.04 keeps the glibc floor at 2.35 so the AppImage runs on older
# distros too. A rolling-release host would want a newer glibc.
#
# Usage:
#   docker compose run --rm appimage [build_appimage.py flags...]

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        git \
        build-essential \
        pkg-config \
        python3 \
        python3-pip \
        python3-venv \
        qt6-base-dev \
        qt6-base-private-dev \
        qt6-declarative-dev \
        qt6-declarative-private-dev \
        patchelf \
        binutils \
        librsvg2-bin \
        libudev-dev \
        libusb-1.0-0-dev \
        libxkbcommon-dev \
        libegl1 \
        libgl1 \
        libfontconfig1 \
        libdbus-1-3 \
        libxcb-cursor0 \
        libxcb-icccm4 \
        libxcb-keysyms1 \
        libxcb-shape0 \
        libxcb-xkb1 \
    && rm -rf /var/lib/apt/lists/*

# penumbra-mtk needs nightly Rust (acon uses const_trait_impl).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain nightly --profile minimal \
    && /root/.cargo/bin/rustup target add x86_64-unknown-linux-gnu

# libudev and libusb link penumbra-mtk's libusb feature.
ENV PATH="/root/.cargo/bin:${PATH}" \
    QMAKE=/usr/bin/qmake6 \
    RCC=/usr/lib/qt6/libexec/rcc

WORKDIR /src

ENTRYPOINT ["python3", "scripts/build_appimage.py"]
