# Cross-compile Umbrage for Windows (x86_64-pc-windows-msvc) inside a container.
#
# Same prerequisites as CROSSCOMPILE.md: cargo-xwin (MSVC toolchain), LLVM
# (clang-cl + lld-link), NSIS (makensis), and aqtinstall.
#
# Usage:
#   docker compose run --rm windows [build_windows.py flags...]
#
# aqtinstall pulls about 1 GB of Qt (target and host) on first run. Mount the
# cache volume so it survives.

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        build-essential \
        pkg-config \
        python3 \
        python3-venv \
        python3-pip \
        clang \
        lld \
        git \
        mingw-w64 \
    && rm -rf /var/lib/apt/lists/*

# penumbra-mtk needs nightly Rust (acon uses const_trait_impl).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain nightly --profile minimal \
    && /root/.cargo/bin/rustup target add x86_64-pc-windows-msvc

# cargo-xwin supplies the MSVC headers and import libs, and links with
# lld-link. mingw-w64 covers the few crates that expect a GNU toolchain.
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /src

ENV CARGO_XWIN_VERSION=0.16.0
RUN cargo install cargo-xwin --version "${CARGO_XWIN_VERSION}" --locked

ENTRYPOINT ["python3", "scripts/build_windows.py"]
