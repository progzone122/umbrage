# Cross-compile Umbrage for Windows (x86_64-pc-windows-msvc) inside a container.
#
# Same prerequisites as CROSSCOMPILE.md: cargo-xwin (MSVC toolchain), LLVM
# (clang-cl + lld-link + llvm-lib), NSIS (makensis), and aqtinstall.
#
# Usage:
#   docker compose run --rm windows [build_windows.py flags...]
#
# aqtinstall pulls about 1 GB of Qt (target and host) on first run. Mount the
# cache volume so it survives.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        build-essential \
        pkg-config \
        python3 \
        python3-venv \
        python3-pip \
        clang \
        lld \
        llvm \
        git \
        mingw-w64 \
        nsis \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu ships lld-link and llvm-lib from the llvm package, but not the
# clang-cl alias. cargo-xwin expects clang-cl; clang reads the driver mode
# from argv[0], so a symlink is enough.
RUN ln -s /usr/bin/clang /usr/local/bin/clang-cl

# penumbra-mtk needs nightly Rust (acon uses const_trait_impl). cargo-xwin
# builds on stable; its version here needs Rust >= 1.89.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain nightly --profile minimal \
    && /root/.cargo/bin/rustup target add x86_64-pc-windows-msvc

# cargo-xwin supplies the MSVC headers and import libs, and links with
# lld-link. mingw-w64 covers the few crates that expect a GNU toolchain.
ENV PATH="/root/.cargo/bin:${PATH}" \
    RUSTUP_TOOLCHAIN=nightly

WORKDIR /src

ENV CARGO_XWIN_VERSION=0.23.1
RUN cargo install cargo-xwin --version "${CARGO_XWIN_VERSION}" --locked

ENTRYPOINT ["python3", "scripts/build_windows.py"]
