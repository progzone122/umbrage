<RCC>
    <qresource prefix="/">
        <file>qtquickcontrols2.conf</file>
    </qresource>

    <qresource prefix="/assets">
        <file>Assets</file>
    </qresource>

    <qresource prefix="/qml">
        <file alias="UmbrageKit">UmbrageKit</file>
        <file alias="Components">Components</file>
        <file alias="Pages">Pages</file>
        <file alias="UmbrageStyles">UmbrageStyles</file>
        <file alias="UmbrageUtils">UmbrageUtils</file>
    </qresource>
</RCC>
